# Public service identity
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://schemagrep.hani-labs.com
MCP_ALLOWED_HOSTS=schemagrep.hani-labs.com
TRUSTED_PROXY_CLIENT_IP_HEADER=x-schemagrep-client-ip

# WorkOS AuthKit: replace every placeholder. Secrets belong in
# /etc/schemagrep-cloud.env with mode 0600, owned by root.
WORKOS_API_KEY=sk_live_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_AUTHKIT_URL=https://replace-me.authkit.app
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-an-independent-32-byte-secret

# Persistent private storage
STORAGE_DIR=/var/lib/schemagrep-cloud
FILE_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=26214400
MAX_ARTIFACT_BYTES=104857600
MAX_SCHEMA_BYTES=4194304
MAX_QUERY_OUTPUT_BYTES=1048576
MAX_TENANT_STORAGE_BYTES=536870912
MAX_TOTAL_STORAGE_BYTES=17179869184
MAX_ACTIVE_FILES_PER_TENANT=20
MAX_ACTIVE_FILES_TOTAL=1000
MIN_FREE_STORAGE_BYTES=1073741824

# Bounded native processing
PROCESS_TIMEOUT_MS=30000
MAX_ACTIVE_WORKERS=4
MAX_QUEUED_WORKERS=16
WORKER_SANDBOX=bwrap
BWRAP_BIN=/usr/bin/bwrap

# Request controls
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Local, data-minimized operations records
PRODUCT_TELEMETRY_PATH=/var/lib/schemagrep-cloud/product-events.jsonl
PRODUCT_TELEMETRY_HASH_KEY=replace-with-an-independent-32-byte-secret
FEEDBACK_PATH=/var/lib/schemagrep-cloud/feedback.jsonl
FEEDBACK_RETENTION_DAYS=30
